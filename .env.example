# AI providers (all optional; tried in order Gemini → Groq → Ollama)
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434

# Transcription: empty = auto (large-v3-turbo on GPU, small on CPU)
WHISPER_MODEL=
USE_GPU=false

MAX_VIDEO_MINUTES=180
STORAGE_DIR=./storage
CLEANUP_HOURS=24

# Comma-separated origins allowed to call the API (add your Cloudflare Pages URL)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
